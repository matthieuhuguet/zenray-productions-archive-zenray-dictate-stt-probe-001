{
 "10020345318418093976": {
  "text": "インターネットで敵対的環境コースについて検索すると、おそらく現地企業の住所が出てくるでしょう",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1404
 },
 "10086073819084529371": {
  "text": "また、北側に行くなら、世界的に有名なマリア像の聖地であるファティマの聖母の聖域、神社を訪れましょう。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1891
 },
 "10112379500600537933": {
  "text": "バルセロナの公用語はカタルーニャ語とスペイン語です。約半数がカタルーニャ語を好み、大多数がカタルーニャ語を理解し、ほぼ全員がスペイン語を知っています。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1484
 },
 "10174984673310355687": {
  "text": "その長い顎には70本以上の鋭い歯が並び、口蓋には別の歯列があり、つまりここを通ったら逃げ道はないということになります。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1761
 },
 "10193386983118883224": {
  "text": "ロスビー数が小さいほど磁気判定に関して星の活性が低下するわけです。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1845
 },
 "10203675650837159328": {
  "text": "群島や湖では必ずしもヨットは必要ありません",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1405
 },
 "10214476888438240131": {
  "text": "パリジャンは自己中心的な横柄で失礼な人が多いと言われています。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1511
 },
 "10228875750894489453": {
  "text": "メインステージの音楽が終わっても、フェスティバルには夜遅くまで演奏を流し続けるセクションがあるかもしれないことを覚えておいてください。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1554
 },
 "10256418415643044307": {
  "text": "参列者の数が多すぎて全員がサンピエトロ広場での葬儀に参加することは不可能でした",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1480
 },
 "10281646305484957883": {
  "text": "香港の最高の景色を見るには、島から出て、クーロンのウォーターフロントに向かいましょう。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1368
 },
 "10300959819649327821": {
  "text": "残念ながら運転手の行動を 100% の確率で予測することはできないので、交通の流れを研究することは困難です。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1600
 },
 "1030930262884292674": {
  "text": "都市はモロッコのスルタンによってダルルバディアとして再建され、貿易拠点を設立したスペイン人貿易商によってカサブランカと名付けられました。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1276
 },
 "10362598397973084151": {
  "text": "復興努力に対するリベラル派からの批判では、ワシントンの内部関係者と思われる人物と復興契約を交わしたことに焦点を当てています。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1269
 },
 "1036356791308610933": {
  "text": "ロランド・メンドーサは M16 ライフルで観光客に発砲しました。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1391
 },
 "10401481013809636276": {
  "text": "残念ながら運転手の行動を 100% の確率で予測することはできないので、交通の流れを研究することは困難です。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1240
 },
 "10413033184319592580": {
  "text": "私たちは植物で家を作り、植物から衣類を作ります。日々食べる食材の多くが植物です。植物がなければ、動物は生きていけません。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 2221
 },
 "10440318583992984584": {
  "text": "78ある提言うち最初に挙げられているのは、敵対的な介入に対してイラクの国境を確保し、近隣諸国との外交関係を再び確立するために、年内に新たな外交主導権を発揮するべきだというものです。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1615
 },
 "10447557607007750141": {
  "text": "ドイツの焼き菓子の多くはアーモンドやヘーゼルナッツなどの木の実を使っています。人気のあるケーキは特に強いコーヒーとよく合います。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1788
 },
 "10457758295680448532": {
  "text": "ヤギの家畜化は約1年万年前に始まり、その中心はイランのザグロス山脈西部であったとされています。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1367
 },
 "10460389341605783008": {
  "text": "昨日の朝、トルコのガジアンテップの警察本部で自動車爆弾の爆発により、警官2名が死亡し、負傷者は20人を超えました。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1555
 },
 "10476284249516566719": {
  "text": "ビデオ録画の利用は数ミリ秒程度続く微表情、つまり顔の動きを解釈する上で重要な発見につながっています",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1387
 },
 "10508563126832413352": {
  "text": "スンダルバンスは世界最大の沿岸マングローブ地帯であり、海外からバングラデシュとインドの内陸地域まで 80km、50マイルにわたって広がっています。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1362
 },
 "10595483280529141687": {
  "text": "これは一部の動詞と目的語を区別する上で重要な方法です。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1706
 },
 "10683203810610128933": {
  "text": "羽を持ち空を飛べるので恐竜だと思っていない人も大勢います。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1410
 },
 "10710420115318518641": {
  "text": "同じように、シェンゲンビザさえ取得すれば、シェンゲン加盟国のビザを個別に申請する必要がなくなり、時間、費用、事務処理の手間が相当に省けます。",
  "info": "harmonic/harmonic-asr-8",
  "firstTextMs": 1630
 }
}