{
 "10020345318418093976": {
  "text": "インターネットで敵対的環境 について検索すると、おそらく現地企業の住所が出てくる でしょう。",
  "info": "nova3/nova-3",
  "firstTextMs": 2289
 },
 "10086073819084529371": {
  "text": "また北側に行くなら世界的に有名なマリア像の 聖地であるファティマの聖母の聖域、神社を訪れましょう",
  "info": "nova3/nova-3",
  "firstTextMs": 3816
 },
 "10112379500600537933": {
  "text": "バルセロナの公用語はカタルーニャ語とスペイン語です。 約半数がカタ語を好み、大多数がカタルーネ語を理解しほぼ全員が スペイン語を知っています",
  "info": "nova3/nova-3",
  "firstTextMs": 3061
 },
 "10174984673310355687": {
  "text": "その長い顎には70本以上の鋭い歯が鳴ら 並び公害には別の私立がありつまりここを通ったら逃げ道はないということになります ます",
  "info": "nova3/nova-3",
  "firstTextMs": 3123
 },
 "10193386983118883224": {
  "text": "ロスビー数が小さいほど磁気判定に関して 星の活性が低下するわけです",
  "info": "nova3/nova-3",
  "firstTextMs": 3825
 },
 "10203675650837159328": {
  "text": "群島や湖では 必ずしもヨットは必要ありません。",
  "info": "nova3/nova-3",
  "firstTextMs": 2270
 },
 "10214476888438240131": {
  "text": "パリジャンは自己中心的だ 横柄で失礼な人が多いと言われています。",
  "info": "nova3/nova-3",
  "firstTextMs": 3184
 },
 "10228875750894489453": {
  "text": "メインステージの音楽が終わっても フェスティバルには喜ぶまで演奏を流し続けるセクションがあるかもしれな こを覚えておいてください。",
  "info": "nova3/nova-3",
  "firstTextMs": 3092
 },
 "10256418415643044307": {
  "text": "参列者の数が多すぎて 全員がサンピエトロ広場での葬儀に参加することは不可能でし た。",
  "info": "nova3/nova-3",
  "firstTextMs": 2221
 },
 "10281646305484957883": {
  "text": "香港の最高の景色を見るには 島から出てクーロンのウォーターフロントに向かいましょう。",
  "info": "nova3/nova-3",
  "firstTextMs": 2310
 },
 "10300959819649327821": {
  "text": "残念ながら運転 手の行動を百パーセントの確率で予測する こはできなので、交通の流れを研究するこは困難です。",
  "info": "nova3/nova-3",
  "firstTextMs": 2298
 },
 "1030930262884292674": {
  "text": "都市はモロッコのスルタンに よってダルルバリアとして再建され、貿易拠点を設立した スペイン人貿易商によってカサブランカと名付けられました。",
  "info": "nova3/nova-3",
  "firstTextMs": 2170
 },
 "10362598397973084151": {
  "text": "復興努力に対するリベラル派からの批判では ワシントンの内部関係者と思われる人物と 復興契約を交わしたことに焦点を当てています。",
  "info": "nova3/nova-3",
  "firstTextMs": 2237
 },
 "1036356791308610933": {
  "text": "ロランド面動作はm十六ライフルで 観光客に発砲しました。",
  "info": "nova3/nova-3",
  "firstTextMs": 2247
 },
 "10401481013809636276": {
  "text": "残念ながら運転手の子 行動100の確率で予測することはできないので 交通の流れを研究することは困難です。",
  "info": "nova3/nova-3",
  "firstTextMs": 2283
 },
 "10413033184319592580": {
  "text": "私たちは植物で家を作り植物から から衣類を作ります。日々食べる食材 の多くが植物です。植物がなければ動物は生きていけまん。",
  "info": "nova3/nova-3",
  "firstTextMs": 4607
 },
 "10440318583992984584": {
  "text": "七十八アール提携 うち最初に挙げられているのは敵対的な 介入に対してイラクの国境を確保し 近隣諸国との外交関係を再び確立するために年内に新た 外交主導権を発揮するべきだというものです。",
  "info": "nova3/nova-3",
  "firstTextMs": 2996
 },
 "10447557607007750141": {
  "text": "ドイツの焼き菓子の多くはアーモンドや ヘーゼルナッツなどの木の実を使っています。 人気のあるケーキは特に 強いコーヒーとよく合います。",
  "info": "nova3/nova-3",
  "firstTextMs": 4210
 },
 "10457758295680448532": {
  "text": "ヤギの家畜が 約一年万年前に始まり、その中心は イランのザクロス山脈西部であったとされています。",
  "info": "nova3/nova-3",
  "firstTextMs": 2988
 },
 "10460389341605783008": {
  "text": "昨日の朝トルコのガジアンテップの経営 察ホームで自動車爆弾の爆発により警官2名が死亡し 負傷者は20人を超えました",
  "info": "nova3/nova-3",
  "firstTextMs": 3031
 },
 "10476284249516566719": {
  "text": "ビデオ録画の利用は数ミリ秒程度続く美表示 つまり顔の動きを解釈する上で重要な発見につながっています",
  "info": "nova3/nova-3",
  "firstTextMs": 2246
 },
 "10508563126832413352": {
  "text": "スンダルバンスは世界最大 の沿岸マングローブ地帯であり海外からバングラデシュ島 インドの内陸地域まで80キロメートル 50マイルにわたって広がっています。",
  "info": "nova3/nova-3",
  "firstTextMs": 2244
 },
 "10595483280529141687": {
  "text": "これは一部の 目的語を区別する上で重要な方法です。",
  "info": "nova3/nova-3",
  "firstTextMs": 3020
 },
 "10683203810610128933": {
  "text": "羽を持つ空を飛べるので 恐竜だと思っていない人も 当然います。",
  "info": "nova3/nova-3",
  "firstTextMs": 2239
 },
 "10710420115318518641": {
  "text": "同じように支援源ビザさえ取得すれば 支援元加盟国のビザを個別に申請する必要がなくなり 時間、費用、事務処理の手間が相当に省けます",
  "info": "nova3/nova-3",
  "firstTextMs": 2240
 }
}